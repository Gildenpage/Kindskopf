-- ============================================================
-- KINDKÖPFE RAID & EVENT PORTAL – SUPABASE DATENBANK
-- Einmal komplett im Supabase SQL Editor ausführen.
-- ============================================================

create table if not exists public.news (
  id bigint generated by default as identity primary key,
  title text not null,
  text text not null,
  created_at timestamptz not null default now()
);

create table if not exists public.raids (
  id bigint generated by default as identity primary key,
  name text not null,
  size integer not null check (size between 1 and 40),
  date date not null,
  time time not null,
  tank_limit integer not null default 2 check (tank_limit >= 0),
  heal_limit integer not null default 5 check (heal_limit >= 0),
  dd_limit integer not null default 3 check (dd_limit >= 0),
  description text not null default '',
  created_at timestamptz not null default now(),
  constraint raid_role_limit check (tank_limit + heal_limit + dd_limit <= size)
);

create table if not exists public.events (
  id bigint generated by default as identity primary key,
  name text not null,
  type text not null default 'Event',
  date date not null,
  time time not null,
  max integer not null check (max between 1 and 100),
  tank_limit integer not null default 2 check (tank_limit >= 0),
  heal_limit integer not null default 3 check (heal_limit >= 0),
  dd_limit integer not null default 5 check (dd_limit >= 0),
  description text not null default '',
  created_at timestamptz not null default now(),
  constraint event_role_limit check (tank_limit + heal_limit + dd_limit <= max)
);

create table if not exists public.calendar_entries (
  id bigint generated by default as identity primary key,
  title text not null,
  type text not null default 'Info',
  date date not null,
  time time,
  description text not null default '',
  created_at timestamptz not null default now()
);

create table if not exists public.signups (
  id bigint generated by default as identity primary key,
  item_type text not null check (item_type in ('raid','event')),
  item_id bigint not null,
  player text not null,
  character text not null,
  class_name text not null,
  spec text not null,
  role text not null check (role in ('Tank','Heiler','DD')),
  created_at timestamptz not null default now()
);

create unique index if not exists signups_unique_player
on public.signups (item_type, item_id, lower(player));

create table if not exists public.admin_users (
  user_id uuid primary key references auth.users(id) on delete cascade,
  created_at timestamptz not null default now()
);

-- ------------------------------------------------------------
-- RLS
-- ------------------------------------------------------------

alter table public.news enable row level security;
alter table public.raids enable row level security;
alter table public.events enable row level security;
alter table public.calendar_entries enable row level security;
alter table public.signups enable row level security;
alter table public.admin_users enable row level security;

-- Öffentliche Leserechte
drop policy if exists "public read news" on public.news;
create policy "public read news"
on public.news for select to anon, authenticated
using (true);

drop policy if exists "public read raids" on public.raids;
create policy "public read raids"
on public.raids for select to anon, authenticated
using (true);

drop policy if exists "public read events" on public.events;
create policy "public read events"
on public.events for select to anon, authenticated
using (true);

drop policy if exists "public read calendar" on public.calendar_entries;
create policy "public read calendar"
on public.calendar_entries for select to anon, authenticated
using (true);

drop policy if exists "public read signups" on public.signups;
create policy "public read signups"
on public.signups for select to anon, authenticated
using (true);

-- ------------------------------------------------------------
-- Adminrechte
-- ------------------------------------------------------------

drop policy if exists "admin manage news" on public.news;
create policy "admin manage news"
on public.news for all to authenticated
using (exists (select 1 from public.admin_users a where a.user_id = auth.uid()))
with check (exists (select 1 from public.admin_users a where a.user_id = auth.uid()));

drop policy if exists "admin manage raids" on public.raids;
create policy "admin manage raids"
on public.raids for all to authenticated
using (exists (select 1 from public.admin_users a where a.user_id = auth.uid()))
with check (exists (select 1 from public.admin_users a where a.user_id = auth.uid()));

drop policy if exists "admin manage events" on public.events;
create policy "admin manage events"
on public.events for all to authenticated
using (exists (select 1 from public.admin_users a where a.user_id = auth.uid()))
with check (exists (select 1 from public.admin_users a where a.user_id = auth.uid()));

drop policy if exists "admin manage calendar" on public.calendar_entries;
create policy "admin manage calendar"
on public.calendar_entries for all to authenticated
using (exists (select 1 from public.admin_users a where a.user_id = auth.uid()))
with check (exists (select 1 from public.admin_users a where a.user_id = auth.uid()));

drop policy if exists "admin delete signups" on public.signups;
create policy "admin delete signups"
on public.signups for delete to authenticated
using (exists (select 1 from public.admin_users a where a.user_id = auth.uid()));

-- Niemand außer Admins darf die Admin-Tabelle lesen/verändern.
drop policy if exists "admin users self read" on public.admin_users;
create policy "admin users self read"
on public.admin_users for select to authenticated
using (user_id = auth.uid());

-- ------------------------------------------------------------
-- Datenbankfunktion für sichere Anmeldungen
-- Sie prüft Raid/Event, freie Plätze, Rollenlimit und Doppelanmeldung.
-- ------------------------------------------------------------

create or replace function public.register_signup(
  p_item_type text,
  p_item_id bigint,
  p_player text,
  p_character text,
  p_class_name text,
  p_spec text,
  p_role text
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_size integer;
  v_tank_limit integer;
  v_heal_limit integer;
  v_dd_limit integer;
  v_count integer;
  v_role_count integer;
  v_max integer;
begin
  if p_item_type not in ('raid','event') then
    return jsonb_build_object('ok', false, 'message', 'Ungültiger Typ.');
  end if;

  if p_role not in ('Tank','Heiler','DD') then
    return jsonb_build_object('ok', false, 'message', 'Ungültige Rolle.');
  end if;

  if trim(p_player) = '' or trim(p_character) = '' then
    return jsonb_build_object('ok', false, 'message', 'Spieler- und Charaktername sind erforderlich.');
  end if;

  if exists (
    select 1 from public.signups
    where item_type = p_item_type
      and item_id = p_item_id
      and lower(player) = lower(trim(p_player))
  ) then
    return jsonb_build_object('ok', false, 'message', 'Dieser Spieler ist bereits angemeldet.');
  end if;

  if p_item_type = 'raid' then
    select size, tank_limit, heal_limit, dd_limit
      into v_size, v_tank_limit, v_heal_limit, v_dd_limit
    from public.raids
    where id = p_item_id;

    if not found then
      return jsonb_build_object('ok', false, 'message', 'Raid nicht gefunden.');
    end if;

    v_max := v_size;
  else
    select max, tank_limit, heal_limit, dd_limit
      into v_max, v_tank_limit, v_heal_limit, v_dd_limit
    from public.events
    where id = p_item_id;

    if not found then
      return jsonb_build_object('ok', false, 'message', 'Event nicht gefunden.');
    end if;
  end if;

  select count(*) into v_count
  from public.signups
  where item_type = p_item_type and item_id = p_item_id;

  if v_count >= v_max then
    return jsonb_build_object('ok', false, 'message', 'Das Event ist voll.');
  end if;

  select count(*) into v_role_count
  from public.signups
  where item_type = p_item_type
    and item_id = p_item_id
    and role = p_role;

  if p_role = 'Tank' and v_role_count >= v_tank_limit then
    return jsonb_build_object('ok', false, 'message', 'Für Tanks sind bereits alle Plätze belegt.');
  elsif p_role = 'Heiler' and v_role_count >= v_heal_limit then
    return jsonb_build_object('ok', false, 'message', 'Für Heiler sind bereits alle Plätze belegt.');
  elsif p_role = 'DD' and v_role_count >= v_dd_limit then
    return jsonb_build_object('ok', false, 'message', 'Für DDs sind bereits alle Plätze belegt.');
  end if;

  insert into public.signups(item_type,item_id,player,character,class_name,spec,role)
  values (p_item_type,p_item_id,trim(p_player),trim(p_character),p_class_name,p_spec,p_role);

  return jsonb_build_object('ok', true, 'message', 'Anmeldung erfolgreich.');
exception
  when unique_violation then
    return jsonb_build_object('ok', false, 'message', 'Dieser Spieler ist bereits angemeldet.');
end;
$$;

-- Die Funktion darf von nicht eingeloggten Besuchern aufgerufen werden.
grant execute on function public.register_signup(text,bigint,text,text,text,text,text) to anon, authenticated;

-- Datenbankberechtigungen für die Data API
grant select on public.news, public.raids, public.events, public.calendar_entries, public.signups to anon, authenticated;
grant select, insert, update, delete on public.news, public.raids, public.events, public.calendar_entries to authenticated;
grant delete on public.signups to authenticated;
grant usage, select on all sequences in schema public to authenticated;

